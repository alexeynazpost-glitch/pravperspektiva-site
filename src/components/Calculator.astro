---
const qs = [
  { key: 'debt', legend: '1. Общая сумма долгов', opts: [['lt500', 'до 500 000 ₽'], ['mid', '500 000 – 1 млн ₽'], ['big', 'больше 1 млн ₽']] },
  { key: 'cred', legend: '2. Сколько у вас кредиторов (банков, МФО, ЖКХ, налоговая)?', opts: [['1-3', '1–3'], ['4-5', '4–5'], ['6-10', '6–10'], ['11+', 'больше 10']] },
  { key: 'assets', legend: '3. Есть ли недвижимость, автомобиль, ипотека или залог?', opts: [['no', 'Нет'], ['yes', 'Да']] },
  { key: 'bail', legend: '4. Приставы закрывали дело, потому что взыскать нечего?', opts: [['yes', 'Да'], ['no', 'Нет'], ['unknown', 'Не знаю']] },
];
---
<section id="calc" class="section" aria-labelledby="calc-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="calc-h">Рассчитайте стоимость — без имени и телефона</h2>
      <p class="muted">Четыре вопроса. Ответ увидите сразу, контакты оставлять не нужно.</p>
    </div>
    <div class="split" style="gap:24px" data-calc>
      <div class="main card card--big" style="gap:24px">
        {qs.map((q) => (
          <fieldset data-key={q.key}>
            <legend>{q.legend}</legend>
            <div class="opts">
              {q.opts.map(([v, l]) => <button type="button" class="opt" aria-pressed="false" data-v={v}>{l}</button>)}
            </div>
          </fieldset>
        ))}
      </div>
      <div class="side calc-result" aria-live="polite">
        <div data-empty>
          <span class="lbl">Ваш результат</span>
          <p style="font-size:20px;font-weight:600;margin-top:6px">Ответьте на четыре вопроса — здесь появится подходящий путь и примерная стоимость.</p>
        </div>
        <div data-full hidden style="flex-direction:column;gap:14px">
          <span class="lbl">Вероятный путь</span>
          <p class="ttl" data-o="pathTitle"></p>
          <p class="txt" data-o="pathNote"></p>
          <div class="sep">
            <span class="lbl" data-o="priceLabel"></span>
            <span class="price" data-o="priceTitle"></span>
            <span class="txt" data-o="priceNote"></span>
          </div>
          <p class="lbl">Обязательные расходы оплачиваются отдельно: вознаграждение финансового управляющего 25 000 ₽ (вносится на депозит суда), а также публикации и почта — обычно около 20 000 ₽ в сумме, зависит от сложности дела.</p>
          <a href="#svyaz" class="btn btn--white">Обсудить мою ситуацию</a>
          <p class="fine">Предварительная оценка, не публичная оферта. Точная стоимость фиксируется в договоре.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  (function () {
    var root = document.querySelector('[data-calc]');
    if (!root) return;
    var s = {};
    var fmt = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' ₽'; };
    var set = function (k, v) { root.querySelector('[data-o=' + k + ']').textContent = v; };
    function render() {
      var complete = s.debt && s.cred && s.assets && s.bail;
      root.querySelector('[data-empty]').hidden = !!complete;
      var full = root.querySelector('[data-full]');
      full.hidden = !complete;
      full.style.display = complete ? 'flex' : 'none';
      if (!complete) return;
      var hard = s.assets === 'yes' || s.cred === '11+';
      var under = s.debt === 'lt500';
      var base = { '1-3': 100000, '4-5': 110000, '6-10': 130000 }[s.cred];
      var mfcLikely = s.debt !== 'big' && s.assets === 'no' && s.bail === 'yes';
      var mfcMaybe = s.debt !== 'big' && s.assets === 'no' && s.bail === 'unknown';
      set('pathTitle', mfcLikely ? 'Сначала проверьте бесплатный путь через МФЦ' : (mfcMaybe ? 'Возможно, подойдёт МФЦ — проверим на разборе' : (under ? 'Нужен разбор: при долге до 500 000 ₽ суд оправдан не всегда' : 'Вероятно, подходит банкротство через суд')));
      set('pathNote', (mfcLikely || mfcMaybe) ? 'Если условия МФЦ не выполняются, поможем с судебным банкротством; ориентир по цене — ниже.' : (under ? 'Обычно через суд идут при долге от 500 000 ₽, в отдельных случаях — от 300 000 ₽. На бесплатном разборе честно скажем, есть ли смысл в вашей ситуации.' : 'Подготовим документы и поведём дело в Арбитражном суде Московской области.'));
      set('priceLabel', (mfcLikely || mfcMaybe) ? 'Если понадобится суд, наши услуги' : 'Наши услуги');
      set('priceTitle', hard ? 'обычно 150 000–170 000 ₽' : fmt(base));
      set('priceNote', hard ? 'В вашей ситуации есть особенности — точную сумму назовём после бесплатного разбора.' : 'или ' + fmt(base / 10) + ' в месяц при рассрочке на 10 месяцев');
      window.ppGoal && window.ppGoal('calc_done');
    }
    root.querySelectorAll('fieldset[data-key]').forEach(function (fs) {
      fs.addEventListener('click', function (e) {
        var b = e.target.closest('.opt');
        if (!b) return;
        s[fs.dataset.key] = b.dataset.v;
        fs.querySelectorAll('.opt').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
        render();
      });
    });
  })();
</script>
