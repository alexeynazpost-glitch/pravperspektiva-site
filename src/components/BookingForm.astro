---
import { site } from '../data/site';
---
<section id="zapis" class="card card--big" style="gap:24px" aria-labelledby="zapis-h">
  <div class="stack" style="--gap:6px">
    <h2 id="zapis-h" style="font-size:28px">Запишитесь на удобное время</h2>
    <p class="small muted">Мы свяжемся ровно в выбранное время и выбранным способом.</p>
  </div>
  <form data-lead="booking" data-ok={`Спасибо, запись принята. Свяжемся в выбранное время с номера ${site.phone}. Если планы изменятся — просто напишите нам.`} novalidate class="stack" style="--gap:24px" data-booking>
    <fieldset data-key="format">
      <legend>1. Как удобнее поговорить</legend>
      <div class="opts">
        {['В офисе', 'По телефону', 'Переписка в MAX', 'Переписка в Telegram'].map((l) => <button type="button" class="opt" aria-pressed="false" data-v={l}>{l}</button>)}
      </div>
    </fieldset>
    <fieldset data-key="day">
      <legend>2. День</legend>
      <div class="opts" data-days></div>
    </fieldset>
    <fieldset data-key="time">
      <legend>3. Время</legend>
      <div class="opts">
        {['8:00', '10:00', '12:00', '14:00', '16:00', '18:00', '19:00'].map((l) => <button type="button" class="opt" aria-pressed="false" data-v={l}>{l}</button>)}
      </div>
    </fieldset>
    <p class="callout" data-summary hidden aria-live="polite"></p>
    <input type="hidden" name="format" />
    <input type="hidden" name="day" />
    <input type="hidden" name="time" />
    <div class="grid" style="--min:240px;--gap:16px">
      <label class="field" for="bk-contact">Телефон или ник в MAX / Telegram
        <input class="ym-hide-content ym-disable-keys" id="bk-contact" type="text" name="contact" placeholder="+7 ... или @ник" autocomplete="tel" />
      </label>
      <label class="field" for="bk-name">Как к вам обращаться <span class="opt-l">(необязательно)</span>
        <input class="ym-hide-content ym-disable-keys" id="bk-name" type="text" name="name" autocomplete="given-name" />
      </label>
    </div>
    <label class="field" for="bk-about">Коротко о ситуации <span class="opt-l">(необязательно)</span>
      <textarea class="ym-hide-content ym-disable-keys" id="bk-about" name="about" rows="3"></textarea>
    </label>
    <label class="consent"><input type="checkbox" name="consent" /><span>Даю <a href="/soglasie/" target="_blank">согласие на обработку персональных данных</a> и принимаю <a href="/politika/" target="_blank">политику конфиденциальности</a>. Данные хранятся на серверах в России.</span></label>
    <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
  <button type="submit" class="btn btn--accent" style="align-self:flex-start">Записаться</button>
    <p class="form-msg" role="status" hidden></p>
  </form>
</section>
<script is:inline define:vars={{ phone: site.phone, expert: site.expert }}>
  (function () {
    var form = document.querySelector('[data-booking]');
    if (!form) return;
    var wd = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
    var mn = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
    var box = form.querySelector('[data-days]');
    var d = new Date();
    for (var i = 0; i < 7; i++) {
      var x = new Date(d.getFullYear(), d.getMonth(), d.getDate() + i);
      var label = (i === 0 ? 'Сегодня' : i === 1 ? 'Завтра' : wd[x.getDay()]) + ', ' + x.getDate() + ' ' + mn[x.getMonth()];
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'opt'; b.setAttribute('aria-pressed', 'false'); b.dataset.v = label; b.textContent = label;
      box.appendChild(b);
    }
    var s = {};
    form.querySelectorAll('fieldset[data-key]').forEach(function (fs) {
      fs.addEventListener('click', function (e) {
        var b = e.target.closest('.opt');
        if (!b) return;
        var k = fs.dataset.key;
        s[k] = b.dataset.v;
        form.querySelector('input[name=' + k + ']').value = b.dataset.v;
        fs.querySelectorAll('.opt').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
        var sum = form.querySelector('[data-summary]');
        if (s.format && s.day && s.time) {
          sum.textContent = 'Вы выбрали: ' + s.format.toLowerCase() + ', ' + s.day.toLowerCase() + ', ' + s.time + '. С вами свяжется ' + expert + ' с номера ' + phone + '.';
          sum.hidden = false;
        }
      });
    });
  })();
</script>
