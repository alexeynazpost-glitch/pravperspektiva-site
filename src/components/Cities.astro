---
import { cityLinks } from '../data/site';
interface Props { title?: string; text?: string; exclude?: string; withHome?: boolean }
const {
  title = 'Где работаем',
  text = 'Офис в Сергиевом Посаде — принимаем жителей Хотькова, Краснозаводска, Пересвета и всего округа. Работаем с жителями ближайших городов Подмосковья и дистанционно по всей России: документы — онлайн, в суде представляем вас по доверенности.',
  exclude,
  withHome = false,
} = Astro.props;
const list = cityLinks.filter((c) => c.slug !== exclude);
---
<section class="section" aria-labelledby="goroda" style="padding-top:0">
  <div class="wrap stack" style="--gap:16px">
    <h2 id="goroda" style="font-size:28px">{title}</h2>
    {text && <p class="muted">{text}</p>}
    <div class="chips">
      {withHome && <a class="chip" href="/">Сергиев Посад</a>}
      {list.map((c) => <a class="chip" href={`/${c.slug}/`}>{c.label}</a>)}
      <a class="chip" href="/distancionno/">Дистанционно по России</a>
    </div>
  </div>
</section>
