---
import { site } from '../data/site';
// photo: 'ulybka' — в костюме у книжных полок (главная), 'rubashka' — в белой рубашке (О компании), 'zhilet' — запасное
const { photo = 'ulybka' } = Astro.props;
const base = { zhilet: '/img/nazarkin', rubashka: '/img/nazarkin-rubashka' }[photo] ?? '/img/nazarkin-ulybka';
---
<aside class="card" aria-label="Кто вам ответит" style="gap:16px;padding:24px;border-radius:20px">
  <picture>
    <source type="image/webp" srcset={`${base}-480.webp 480w, ${base}-800.webp 800w`} sizes="(max-width: 640px) 90vw, 360px" />
    <img src={`${base}-800.jpg`} alt={site.expert + ', руководитель «Юстики»'} width="800" height="1000" loading="eager" decoding="async" style="display:block;width:100%;height:auto;max-height:420px;object-fit:cover;object-position:50% 20%;border-radius:14px;background:#E6EFEF" />
  </picture>
  <div style="display:flex;flex-direction:column;gap:4px">
    <span style="font-weight:700;font-size:20px;color:var(--text)">{site.expert}</span>
    <span class="note" style="font-size:16px">{site.expertRole}</span>
  </div>
  <p style="background:var(--cream);border-radius:12px;padding:14px 16px;font-size:16px;color:var(--text)">Звоним и пишем только с номера <strong style="white-space:nowrap">{site.phone}</strong>. Мы не банк и не коллекторы.</p>
</aside>
