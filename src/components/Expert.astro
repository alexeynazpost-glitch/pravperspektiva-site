---
import { site } from '../data/site';
// ЗАПОЛНИТЬ: фото эксперта. Пока показываем монограмму.
---
<aside class="card" aria-label="Кто вам ответит" style="gap:16px;padding:24px;border-radius:20px">
  <div style="height:240px;border-radius:14px;background:linear-gradient(135deg,#E6EFEF,#CFE0E1);display:flex;align-items:center;justify-content:center" role="img" aria-label={site.expert}>
    <span style="width:120px;height:120px;border-radius:60px;background:#0F4C5C;color:#fff;font-size:44px;font-weight:700;display:flex;align-items:center;justify-content:center">АН</span>
  </div>
  <div style="display:flex;flex-direction:column;gap:4px">
    <span style="font-weight:700;font-size:20px;color:var(--text)">{site.expert}</span>
    <span class="note" style="font-size:16px">{site.expertRole}</span>
  </div>
  <p style="background:var(--cream);border-radius:12px;padding:14px 16px;font-size:16px;color:var(--text)">Звоним и пишем только с номера <strong style="white-space:nowrap">{site.phone}</strong>. Мы не банк и не коллекторы.</p>
</aside>
