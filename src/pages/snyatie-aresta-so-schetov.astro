---
import Related from '../layouts/Related.astro';
const faq = [
  { q: 'Списали детское пособие — можно вернуть?', a: '<p>Да, на большинство детских выплат взыскание не обращается. Поможем с заявлением приставу и в банк.</p>' },
  { q: 'Какие счета не арестовывают?', a: '<p>Арестовать могут счёт в любом банке — «банков, куда приставы не доберутся», не существует. Зато закон запрещает списывать отдельные выплаты и обязывает оставлять прожиточный минимум по заявлению должника — именно этим и защищаемся.</p>' },
];
---
<Related
  title="Приставы арестовали счета — что делать и как сохранить прожиточный минимум | Правовая перспектива"
  description="Приставы списывают всё с карты? Поможем сохранить прожиточный минимум, вернуть списанные пособия и оценим, поможет ли банкротство."
  crumb="Снятие арестов со счетов"
  h1="Приставы арестовали счета — что делать"
  lead="Даже при долгах закон оставляет вам деньги на жизнь. Поможем сохранить прожиточный минимум, вернуть списанные по ошибке деньги и решить вопрос с долгами целиком."
  faq={faq}
  cases={[2]}
>
  <section class="section" style="padding-top:16px" aria-labelledby="mozhno">
    <div class="wrap stack" style="--gap:20px">
      <h2 id="mozhno">Что можно сделать</h2>
      <div class="grid" style="--min:280px">
        <div class="card"><h3>Сохранить прожиточный минимум</h3><p>По заявлению должника пристав обязан сохранять ежемесячный доход в размере прожиточного минимума. Подготовим заявление и проконтролируем.</p></div>
        <div class="card"><h3>Вернуть деньги, которые нельзя списывать</h3><p>Детские пособия, алименты на детей и другие выплаты, на которые взыскание не обращается (ст. 101 закона об исполнительном производстве).</p></div>
        <div class="card"><h3>Решить вопрос целиком</h3><p>После признания банкротом аресты, наложенные приставами, снимаются (п. 5 ст. 213.25 закона № 127-ФЗ).</p></div>
      </div>
    </div>
  </section>
</Related>
