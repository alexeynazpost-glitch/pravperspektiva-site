---
import Related from '../layouts/Related.astro';
const faq = [
  { q: 'Коллекторы звонят маме — это законно?', a: '<p>Обсуждать с родственниками ваш долг нельзя без согласия и вашего, и их. Такие звонки — основание для жалобы в ФССП.</p>' },
  { q: 'Звонят коллекторы, а долгов нет?', a: '<p>Это может быть ошибка (ищут прежнего владельца номера) или мошенники. Не называйте свои данные и коды из СМС, попросите назвать организацию и проверьте её в реестре ФССП. При нарушениях можно пожаловаться в ФССП.</p>' },
  { q: 'Могут ли коллекторы звонить при банкротстве?', a: '<p>Нет. С момента, когда суд признал обоснованным заявление о банкротстве, звонить и приходить к должнику запрещено (ч. 1 ст. 7 закона № 230-ФЗ).</p>' },
];
---
<Related
  title="Звонят коллекторы — что делать и что им запрещено по закону | Юстика"
  description="Коллекторы звонят часто, ночью или родственникам? Объясним ваши права, поможем с жалобой и отказом от взаимодействия. Бесплатный разбор."
  crumb="Защита от коллекторов"
  h1="Звонят коллекторы — что делать"
  lead="Коллекторы обязаны соблюдать закон. Расскажем, что они вправе делать, а что нет, и поможем остановить давление. А если долги уже не потянуть — честно скажем, поможет ли банкротство."
  faq={faq}
  cases={[2]}
>
  <section class="section" style="padding-top:16px" aria-labelledby="zapret">
    <div class="wrap grid" style="--min:320px">
      <div class="card card--big" style="gap:16px">
        <h2 id="zapret" style="font-size:28px">Что коллекторам запрещено</h2>
        <p class="note">Закон № 230-ФЗ</p>
        <ul class="checklist checklist--col">
          <li>звонить чаще 1 раза в день, 2 раз в неделю и 8 раз в месяц;</li>
          <li>звонить в будни с 22:00 до 8:00, в выходные и праздники — с 20:00 до 9:00;</li>
          <li>угрожать, давить, вводить в заблуждение о последствиях;</li>
          <li>обсуждать ваш долг с родственниками, соседями и на работе без вашего согласия.</li>
        </ul>
        <p class="callout">Сообщения (СМС, мессенджеры, голосовые) — не больше 2 в сутки, 4 в неделю и 16 в месяц (ст. 7 закона № 230-ФЗ). А с момента, когда суд признал обоснованным заявление о банкротстве, звонить и приходить к вам вообще запрещено.</p>
      </div>
      <div class="card card--big" style="gap:16px">
        <h2 style="font-size:28px">Что мы делаем</h2>
        <ul class="checklist checklist--col">
          <li>проверяем, есть ли коллектор в реестре ФССП и законно ли он действует;</li>
          <li>готовим заявление об отказе от взаимодействия или об общении только через представителя (ст. 8 закона № 230-ФЗ);</li>
          <li>помогаем с жалобой в ФССП на нарушения;</li>
          <li>оцениваем, нужно ли банкротство: после введения процедуры кредиторы могут требовать деньги только в суде.</li>
        </ul>
      </div>
    </div>
  </section>
</Related>
