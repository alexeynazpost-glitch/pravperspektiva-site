---
import Base from '../../../layouts/Base.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import { getCollection, render } from 'astro:content';
import { blogRubrics, site } from '../../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { rubric: p.data.rubric, slug: p.id }, props: { p, all: posts } }));
}
const { p, all } = Astro.props;
const { Content, headings } = await render(p);
const rubric = blogRubrics.find((r) => r.slug === p.data.rubric)!;
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const shown = p.data.updated ?? p.data.date;
const words = (p.body ?? '').split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 180));
const related = all.filter((x: any) => x.id !== p.id && x.data.rubric === p.data.rubric).slice(0, 3);
const url = new URL(Astro.url.pathname, site.url).href;
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: p.data.title, description: p.data.description,
  datePublished: p.data.date.toISOString(), dateModified: shown.toISOString(), mainEntityOfPage: url,
  author: { '@type': 'Person', name: site.expert, jobTitle: 'Руководитель «Юстики»' },
  publisher: { '@id': site.url + '/#org' }, inLanguage: 'ru',
};
---
<Base
  title={(p.data.seoTitle ?? p.data.title) + ' | Юстика'}
  description={p.data.description}
  type="article"
  crumbs={[{ href: '/blog/', label: 'Блог' }, { href: `/blog/${rubric.slug}/`, label: rubric.label }, { label: p.data.title }]}
  faq={p.data.faq}
  schema={[article]}
>
  <div class="wrap split" style="padding-bottom:72px;gap:48px">
    <article class="main prose" style="flex-basis:640px">
      <h1 style="font-size:clamp(30px,3.6vw,42px);line-height:1.2">{p.data.title}</h1>
      <div class="row" style="--gap:14px;font-size:15px;color:var(--muted-2);line-height:1.4">
        <img src="/img/nazarkin-face.webp" alt="" width="48" height="48" style="border-radius:24px;flex:none" />
        <div style="display:flex;flex-direction:column"><span style="color:var(--text);font-weight:600">{site.expert}, руководитель «Юстики»</span><span>Обновлено {fmt(shown)} · {minutes} мин чтения</span></div>
      </div>
      <p style="font-size:20px;color:var(--muted)"><strong>Коротко:</strong> {p.data.summary}</p>
      {toc.length > 1 && (
        <nav class="card" aria-label="Содержание" style="line-height:1.5">
          <strong>Содержание</strong>
          <ol style="margin:0;padding-left:22px">{toc.map((h) => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <Content />
      <aside class="calc-result" aria-label="Рассчитать стоимость" style="line-height:1.5">
        <strong style="font-size:22px">Хотите понять, подходит ли банкротство именно вам?</strong>
        <span class="txt">Четыре вопроса без имени и телефона — сразу увидите путь и примерную стоимость.</span>
        <a href="/#calc" class="btn btn--white" style="align-self:flex-start">Рассчитать самостоятельно</a>
      </aside>
      {p.data.faq.length > 0 && (
        <section class="stack" style="--gap:14px">
          <h2 id="voprosy">Частые вопросы</h2>
          <div class="faq">{p.data.faq.map((f: any) => <details><summary>{f.q}</summary><div class="a"><p>{f.a}</p></div></details>)}</div>
        </section>
      )}
      {related.length > 0 && (
        <section class="stack" style="--gap:12px;border-top:1px solid var(--line);padding-top:24px">
          <h2 style="font-size:22px;margin:0">Читайте также</h2>
          {related.map((r: any) => <a href={`/blog/${r.data.rubric}/${r.id}/`} style="font-weight:600">{r.data.title}</a>)}
        </section>
      )}
      <p class="note">{site.disclaimer}</p>
    </article>
    <BlogSidebar current={rubric.slug} />
  </div>
</Base>
