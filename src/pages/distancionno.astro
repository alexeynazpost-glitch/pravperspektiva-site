---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContactOptions from '../components/ContactOptions.astro';
import Faq from '../components/Faq.astro';
const faq = [
  { q: 'В какой суд подаётся заявление?', a: '<p>Заявление подаётся по месту жительства, а не работы. Для жителей Подмосковья это Арбитражный суд Московской области. Если вы живёте в другом регионе, дело рассматривает арбитражный суд вашего региона.</p>' },
  { q: 'Нужно ли самому ходить в суд?', a: '<p>Нет. На заседаниях вас представляем мы. Для этого нужна только нотариальная доверенность — её можно оформить у любого нотариуса рядом с домом.</p>' },
  { q: 'Как заключить договор, если я далеко?', a: '<p>Договор заключаем по электронной почте или обычной почтой.</p>' },
];
---
<Base
  title="Банкротство физических лиц дистанционно — по всей России | Правовая перспектива"
  description="Банкротство без поездок: консультация по телефону или в переписке, документы онлайн, договор по почте, в суде представляем по нотариальной доверенности. Бесплатный разбор."
  crumbs={[{ label: 'Дистанционно по России' }]}
  faq={faq}
>
  <Hero
    h1="Банкротство дистанционно — по всей России"
    lead="Если вы живёте далеко, приезжать не обязательно: консультация — по телефону или в переписке, документы — онлайн, в суде представляем вас по нотариальной доверенности. Договор заключаем по электронной почте или обычной почтой."
    buttons={[{ href: '#svyaz', label: 'Задать вопрос анонимно', kind: 'accent' }, { href: '/kontakty/#zapis', label: 'Записаться на разбор', kind: 'outline' }]}
  />
  <section class="section" style="padding-top:16px" aria-labelledby="kak">
    <div class="wrap stack" style="--gap:20px">
      <h2 id="kak">Как это устроено</h2>
      <ol class="steps-list">
        <li><span class="num">1</span><div><strong>Бесплатный разбор.</strong> <span class="t">По телефону или в переписке, ежедневно с 8:00 до 20:00. Можно без имени.</span></div></li>
        <li><span class="num">2</span><div><strong>Договор.</strong> <span class="t">По электронной почте или обычной почтой. Цена и рассрочка — в договоре.</span></div></li>
        <li><span class="num">3</span><div><strong>Документы.</strong> <span class="t">Большую часть справок запрашиваем сами. Что нужно от вас — пришлём списком.</span></div></li>
        <li><span class="num">4</span><div><strong>Суд.</strong> <span class="t">Подаём заявление и представляем вас на заседаниях по нотариальной доверенности.</span></div></li>
        <li><span class="num">5</span><div><strong>Завершение.</strong> <span class="t">Работаем с финансовым управляющим и кредиторами до итогового решения суда. Всё время держим вас в курсе.</span></div></li>
      </ol>
    </div>
  </section>
  <Faq items={faq} />
  <ContactOptions />
</Base>
